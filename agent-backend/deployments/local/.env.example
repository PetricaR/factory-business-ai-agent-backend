# Environment Configuration Template
# Copy this file to .env and fill in your values

# ====================
# Google Cloud Settings
# ====================
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global

# ====================
# API Keys (Required)
# ====================

# Google Maps API Key (for location intelligence)
GOOGLE_MAPS_API_KEY=your-maps-api-key-here

# Targetare API Key (for Romanian business data)
API_KEY_TARGETARE=your-targetare-api-key-here

# ====================
# API Keys (Optional)
# ====================

# Google Custom Search (for web research)
GOOGLE_CUSTOM_SEARCH_API_KEY=your-custom-search-key
GOOGLE_CUSTOM_SEARCH_CX=your-search-engine-id

# ====================
# Model Configuration
# ====================
MODEL=gemini-2.0-flash-exp

# ====================
# MCP Server
# ====================
MCP_SERVER_URL=http://localhost:8000/mcp

# ====================
# Feature Flags
# ====================
ENABLE_TARGETARE=true
ENABLE_MAPS=true
ENABLE_WEB_SEARCH=true

# ====================
# Development Settings
# ====================
LOG_LEVEL=INFO
PORT=8082
